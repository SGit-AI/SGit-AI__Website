# ── generated pages: keep diffs quiet in PRs ──────────────────────────
# Every *.html is produced by admin/build/build_pages.py; mark it
# generated so code hosts collapse these diffs and reviewers look at the
# generator instead.
*.html linguist-generated=true

# ── raw sgit store files, should any ever be tracked: opaque ciphertext ─
# No vault store is tracked in this repository any more (the site's own
# mirror was retired at v0.2.84), but the rule stays as defence in depth:
# ciphertext has no meaningful line-based diff, and a textual merge would
# corrupt it.
obj-cas-imm-* binary -diff -merge
ref-pid-*     binary -diff -merge
idx-pid-*     binary -diff -merge
key-rnd-imm-* binary -diff -merge
branch-named-* binary -diff -merge
branch-clone-* binary -diff -merge
